# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=your-bot-token-here

# Application ID from the "General Information" page of your application
CLIENT_ID=your-application-id-here

# Optional: a server (guild) ID. When set, slash commands deploy to that one
# server instantly, which is ideal for development. Leave it empty to deploy
# globally (can take up to an hour to propagate).
GUILD_ID=
